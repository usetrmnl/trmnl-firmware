.DS_Store
.pio
/builds/*
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/extensions.json
.vscode/launch.json
.vscode/ipch
.idea
.vscode/settings.json

# Per-target ESP-IDF sdkconfigs are committed under sdkconfigs/.
# Ignore any sdkconfig.* generated at the repo root (legacy / non-redirected envs).
/sdkconfig.*

# Backups generated by menuconfig
/sdkconfigs/*.old

# These per-target configs are build-generated and intentionally not committed.
/sdkconfigs/sdkconfig.trmnl
/sdkconfigs/sdkconfig.trmnl_4clr
/sdkconfigs/sdkconfig.trmnl_gen2
/sdkconfigs/sdkconfig.local

# Localization / branding build artifacts, regenerated from config.yml at build
# time by scripts/generate_branding.py. Untracked so downstream customization
# never diffs a committed file.
/include/branding.h
/src/wifi_connect_qr.h
/src/wifi_failed_qr.h
/lib/wificaptive/src/WifiCaptivePage.h

# Custom logo overrides: sidecars emitted when config.yml points images.* at a
# PNG; the committed stock logo headers include them via __has_include.
/src/logo_small.local.h
/src/logo_medium.local.h
/src/logo_big.local.h
/src/loading.local.h
/lib/wificaptive/src/wifi_ssid.local.h

# Downstream white-label overrides, deep-merged over config.yml by the generator.
/config.local.yml

# Handled by espressif
managed_components/

# Integration test environment (contains secrets)
test/integration/test_config.h
dependencies.lock
